{
  "name": "frontier-feature-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Competitive Feature, Model Release, and Market Share Opportunity Tracker for xAI / SpaceXAI",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "export-data": "node --import tsx scripts/export-static-data.ts",
    "predev": "npm run export-data",
    "prebuild": "npm run export-data",
    "build": "npm run build -w @fft/dashboard",
    "build:pages": "GITHUB_PAGES=true GITHUB_REPOSITORY=rdsciv/GrokProductRoadmap npm run build",
    "seed": "npm run seed -w @fft/db",
    "dev": "npm run dev -w @fft/dashboard",
    "collect": "npm run collect -w @fft/collectors",
    "report:baseline": "node --import tsx scripts/generate-baseline-report.ts",
    "report:weekly": "node --import tsx scripts/generate-weekly-report.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run validate:data && npm test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "yaml": "^2.8.0"
  }
}
